# Copia este archivo como ".env" (local) y complétalo con tus valores reales.
# En Vercel, configura estas mismas variables en:
#   Project Settings → Environment Variables

# Cadena de conexión de Neon DB (console.neon.tech → tu proyecto → Connection Details)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Secreto para firmar los tokens de sesión del panel de administración.
# Genera uno aleatorio con: openssl rand -hex 32
SESSION_SECRET=reemplaza_esto_con_una_cadena_aleatoria_larga
